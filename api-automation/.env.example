# Copy this file to .env and fill in real values. Never commit .env.
# See README.md "Configuration" for what each of these unlocks.

# Target environment. Mirrors cypress.config.js's ENV names (dev/prod).
# prod is refused unless ALLOW_PROD=true is also set — see src/config/env.js.
API_ENV=dev

# Override the environment's default base URL if needed.
# Defaults: dev -> https://devvms.tractorfirst.com
#           prod -> https://prodvms.tractorjunction.in
# API_BASE_URL=

# A real, already-provisioned admin user's email in the target environment.
# Unlocks: POST /api/v1/login (AuthToken-protected endpoints), and via
# POST /api/v1/user/fake-user, role-impersonation tokens for RBAC tests.
# No password needed — the VMS admin-panel login is email-only per the spec
# (identity is established upstream via Google OAuth in the real UI flow).
ADMIN_EMAIL=

# A real mobile number registered (or auto-registerable) in the VMT
# (customer app / Traco) user collection. Unlocks VmsAuthToken-protected
# /api/v1/vmt/* endpoints. OTP verification uses the spec-documented static
# non-production value "12345" — no real OTP needed.
VMT_TEST_MOBILE=

# Static API key for partner/other-platform routes (ApiKeyAuth scheme).
# Only needed for the OtherPlatform-tagged endpoints.
# PARTNER_API_KEY=

# Set to "true" to enable the generated POST/PUT/PATCH/DELETE regression and
# negative suites, plus the hand-written CRUD workflow(s). These write real
# records to whatever API_BASE_URL points at. Leave unset/false against any
# shared/team dev database. See README "Safety model".
RUN_MUTATING=false

# Required to run anything at all against API_ENV=prod. Leave unset.
# ALLOW_PROD=true
