{
  "name": "vms-web-automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "cypress:open": "cypress open",
    "test": "cypress run",
    "test:local": "cross-env ENV=local cypress run",
    "test:dev": "cross-env ENV=dev cypress run",
    "test:qa": "cross-env ENV=qa cypress run",
    "test:uat": "cross-env ENV=uat cypress run",
    "test:staging": "cross-env ENV=staging cypress run",
    "test:prod": "cross-env ENV=prod cypress run",
    "test:regression": "cross-env ENV=dev cypress run --spec \"cypress/e2e/Test_Case/Regression_Suite/**/*.cy.js\"",
    "report:clean": "rm -rf allure-results allure-report",
    "report:allure": "allure generate ./allure-results",
    "report:open": "allure open ./allure-report/allure2",
    "report:deploy": "node -r dotenv/config -e \"require('./cypress/plugins/publishAllureReport').publishAllureReport().then((u) => u && console.log(u))\""
  },
